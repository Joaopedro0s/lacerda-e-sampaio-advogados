# URL pública do site (usada em metadata, sitemap e JSON-LD)
NEXT_PUBLIC_SITE_URL=https://escritorio.example

# Envio do formulário de contato via Resend (https://resend.com).
# Sem RESEND_API_KEY e CONTACT_TO_EMAIL, em desenvolvimento a mensagem é apenas registrada no console.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
